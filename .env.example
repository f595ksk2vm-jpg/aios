# AI-OS configuration. Every setting is optional; the defaults give a local single-machine install.

# --- topology ---------------------------------------------------------------
AIOS_DEPLOYMENT_MODE=local          # local | cloud | hybrid (descriptive; placement is enforced per worker and per organization)
AIOS_WORKER_LOCATION=local          # local | cloud — where THIS process runs
AIOS_EMBEDDED_WORKER=true           # run a worker inside the API process (turn off when workers are separate)
AIOS_WORKER_CONCURRENCY=4

# --- state ------------------------------------------------------------------
AIOS_DATA_DIR=./data                # workspaces, backups, SQLite file, master key
# AIOS_DATABASE_URL=postgresql+asyncpg://aios:password@db:5432/aios   # default: SQLite in AIOS_DATA_DIR

# --- security ---------------------------------------------------------------
# AIOS_SECRET_KEY=                  # Fernet key for the secret store; generated into data/master.key if unset
# AIOS_ADMIN_EMAIL=                 # create the owner account on first start (otherwise the UI asks)
# AIOS_ADMIN_PASSWORD=
AIOS_SESSION_TTL_HOURS=12

# --- agent execution ----------------------------------------------------------
AIOS_SANDBOX_DRIVER=auto            # auto | subprocess | docker
AIOS_SANDBOX_DOCKER_IMAGE=python:3.12-slim
AIOS_SANDBOX_TIMEOUT_S=60
AIOS_SANDBOX_MEMORY_MB=1024
AIOS_MAX_RUN_STEPS=40

# --- agent network egress -------------------------------------------------------
AIOS_HTTP_ALLOW_PRIVATE=false       # allow agent HTTP tools to reach private addresses
# AIOS_HTTP_ALLOWED_HOSTS=api.github.com,example.com   # empty = any public host
# AIOS_SEARCH_URL=http://searxng:8080/search            # SearxNG-compatible JSON search for the web_search tool

# --- memory -----------------------------------------------------------------
AIOS_EMBEDDER=hashing               # hashing (built in, offline) | openai_compat
# AIOS_EMBEDDER_BASE_URL=http://localhost:11434/v1
# AIOS_EMBEDDER_MODEL=nomic-embed-text

# Model provider keys are NOT set here: store them in the UI (AI-OS → Security → Secrets), e.g. ANTHROPIC_API_KEY.
